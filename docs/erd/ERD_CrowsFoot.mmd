erDiagram
    %% Crow's Foot notation: product exactly one; price zero-or-one per branch.
    %% No supertype/subtype. Two branches compare two alternative solutions.
    Product ||--o| ProductPrice_Manual : "0..1 current price (TV2)"
    Product ||--o| ProductPrice_Native : "0..1 current price (TV3)"
    Product {
        INT ProductID PK
        VARCHAR_20 ProductCode UK
        NVARCHAR_100 ProductName
        NVARCHAR_60 Category
    }
    ProductPrice_Manual {
        INT ProductID PK,FK
        DECIMAL_12_2 UnitPrice
        CHAR_3 CurrencyCode
        NVARCHAR_120 PriceNote
    }
    ProductPrice_Native {
        INT ProductID PK,FK
        DECIMAL_12_2 UnitPrice
        CHAR_3 CurrencyCode
        NVARCHAR_120 PriceNote
    }
